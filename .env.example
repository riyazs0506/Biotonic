# ─────────────────────────────────────────────────────────────────────────────
# Biotonic website — environment variables (example only, no real secrets)
# Copy to `.env` locally or set these in the hosting provider's dashboard.
# NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Build-time (public — embedded in the browser bundle, never secret) ──────
# draft   = placeholders visible, every page noindex (staging/review)
# release = placeholders hidden, incomplete pages unpublished, indexable
VITE_CONTENT_MODE=draft
# Production origin, no trailing slash. Used for canonical URLs, sitemap, schema.
VITE_SITE_URL=https://www.example.com

# ── Runtime (server only — private) ─────────────────────────────────────────
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
# Must match VITE_SITE_URL. Used to verify the Origin of enquiry submissions.
SITE_URL=https://www.example.com
# Optional extra allowed origins, comma separated (e.g. a staging domain).
ALLOWED_ORIGINS=
# Set to true when behind a reverse proxy / load balancer / CDN.
TRUST_PROXY=true
# Redirect HTTP→HTTPS and send HSTS (requires TRUST_PROXY behind a TLS proxy).
FORCE_HTTPS=true

# Enquiry email delivery: smtp | disabled
# (`capture` exists for local development/tests only and is refused in production.)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender on the email provider, e.g. "Biotonic Website <website@example.com>"
MAIL_FROM=
# Fixed internal recipient for all enquiries (never taken from the request)
ENQUIRY_TO=

# Abuse protection (per client IP, per window) and a global hourly ceiling
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_GLOBAL_PER_HOUR=200
