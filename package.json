{
  "name": "biotonic-website",
  "version": "1.0.0",
  "description": "Biotonic corporate website — React + Vite + TypeScript with a Node enquiry service",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/dev.ts",
    "build": "npm run content:check && npm run build:client && npm run build:ssr && npm run prerender && npm run build:server",
    "build:release": "VITE_CONTENT_MODE=release npm run content:check && VITE_CONTENT_MODE=release npm run build",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist/ssr",
    "prerender": "tsx scripts/prerender.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "content:check": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:links": "tsx scripts/check-links.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:links && npm run scan:secrets && npm run test:e2e",
    "start:local": "NODE_ENV=development MAIL_TRANSPORT=capture SITE_URL=http://localhost:8787 node dist/server/index.js",
    "check:release-render": "VITE_CONTENT_MODE=release VITE_SITE_URL=https://release-check.example npm run build:client && VITE_CONTENT_MODE=release VITE_SITE_URL=https://release-check.example npm run build:ssr && VITE_CONTENT_MODE=release npm run prerender"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "nodemailer": "^10.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  }
}
