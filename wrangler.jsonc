// Cloudflare Workers deployment (`npx wrangler deploy`, run after `npm run build`).
// Secrets are NOT stored here: set them with `npx wrangler secret put RESEND_API_KEY`
// or in the Cloudflare dashboard (Worker → Settings → Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biotonic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // Unknown URLs get dist/client/404.html with a real HTTP 404.
    "not_found_handling": "404-page",
    // /about/ → /about, matching the canonical URLs.
    "html_handling": "drop-trailing-slash",
    // Only the API runs through the Worker; everything else is served as static assets.
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "vars": {
    // "disabled" until email is set up: the form then says "temporarily unavailable"
    // instead of pretending to send. Switch to "resend" once RESEND_API_KEY is set.
    "MAIL_TRANSPORT": "disabled",
    // Verified sender on Resend, e.g. "Biotonic Website <website@your-domain>"
    "MAIL_FROM": "",
    // Fixed inbox that receives every enquiry.
    "ENQUIRY_TO": "",
    // Extra allowed origins for the enquiry form (comma separated); the site's own origin is
    // always allowed.
    "ALLOWED_ORIGINS": "",
  },
}
